# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채운다.
#   Windows : copy .env.example .env
#   macOS / Linux : cp .env.example .env
# .env 는 API 키가 포함되어 있으므로 형상관리에 올리지 않는다.

# OpenAI API 키 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
MAX_REPLAN=3
# 실행 로그 저장소. 비워 두면 data/planner.db
PLANNER_DB_PATH=

# 한국은행 ECOS Open API 인증키 (https://ecos.bok.or.kr/api/)
ECOS_OPEN_API=

# 국가법령정보 공동활용 API 인증값 OC (https://open.law.go.kr/)
LAW_API_OC=

# 한국전력 전력데이터개방포털 API 키 (https://bigdata.kepco.co.kr/)
KEP_CO_API=
